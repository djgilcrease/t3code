{
  "name": "@t3tools/plugin-sdk",
  "version": "0.1.0",
  "description": "Versioned server plugin API and portable UI contributions for T3 Code",
  "license": "MIT",
  "files": [
    "src/index.ts",
    "dist/index.js",
    "dist/index.d.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
